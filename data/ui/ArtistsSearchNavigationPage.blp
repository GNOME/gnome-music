using Gtk 4.0;
using Adw 1;

template $ArtistsSearchNavigationPage: Adw.NavigationPage {
  title: _("Artists");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      focusable: false;
      hexpand: true;
      vexpand: true;
      hscrollbar-policy: never;

      Adw.Clamp {
        maximum-size: 1600;

        Box {
          halign: fill;
          hexpand: true;
          margin-bottom: 20;
          margin-end: 120;
          margin-start: 120;
          margin-top: 20;
          orientation: vertical;

          FlowBox _all_artists_flowbox {
            column-spacing: 6;
            halign: fill;
            hexpand: true;
            homogeneous: true;
            margin-bottom: 18;
            margin-top: 18;
            max-children-per-line: 6;
            min-children-per-line: 1;
            row-spacing: 12;
            selection-mode: none;
            valign: start;
            child-activated => $_on_artist_activated();
          }
        }
      }
    };
  }
}
