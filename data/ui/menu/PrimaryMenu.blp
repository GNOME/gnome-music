using Gtk 4.0;

menu primary_menu {
  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("Help");
      action: "app.help";
    }

    item {
      label: _("About Music");
      action: "app.about";
    }
  }
}
